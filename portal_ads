    for (var i = 0; i < 13; i++) { var v = ALPHA.indexOf(c.charAt(i)); if (v < 0) return false; tot = (tot + v * (i + 1)) % 31; }
    return ALPHA.charAt(tot) === c.charAt(13);
  }

  // ---- نافذة الظهور (مطابقة لـadvertisers_core.dart)
  function winState(s, e, now) {
    if (s && new Date(s) > now) return 'sched';
