    var i = 0;
    slideTimer = setInterval(function () {
      i = (i + 1) % sl.children.length;
      var c = sl.children[i];
      sl.scrollTo({ left: c.offsetLeft - sl.offsetLeft - 8 * (document.documentElement.dir === 'rtl' ? -1 : 1), behavior: 'smooth' });
    }, 3500);
  }

  function render() {
    applyLang();
    renderTools();
    var app = document.getElementById('app');
    app.innerHTML = data ? mainView() : loginView();
    var go = document.getElementById('go');
    if (go) {
      var cd = document.getElementById('cd');
      go.onclick = function () { code = cd.value; load(false); };
      cd.onkeydown = function (e) { if (e.key === 'Enter') { code = cd.value; load(false); } };
    }
    var sb = document.getElementById('scanbtn'); if (sb) sb.onclick = function () { if (window.APO_PWA) window.APO_PWA.scan(); };
    var rf = document.getElementById('rf'); if (rf) rf.onclick = function () { load(true); };
    startSlider();
  }

  function load(isRefresh) {
    err = ''; note = '';
    var c = norm(code);
    if (!chkOk(c)) { err = t(c.length === 14 ? 'typo' : 'bad'); data = null; render(); return; }
    if (isRefresh && data) { loading = true; render(); } else if (!isRefresh) { busy = true; render(); }
    var started = Date.now();
    rpc('advertiser_portal_get', { p_code: c }).then(function (r) {
      var wait = isRefresh ? Math.max(0, 450 - (Date.now() - started)) : 0;   // يبقى المؤشر ظاهراً لحظة كي يلاحظه المستخدم
      setTimeout(function () {
        busy = false; loading = false;
        if (!r) { data = null; err = t('bad'); store('apo_adv_code', null); }
        else { data = r; code = c; updatedAt = new Date(); if (isRefresh) note = 'ok'; store('apo_adv_code', c); }
        render();
      }, wait);
    }).catch(function () {
      busy = false; loading = false;
      if (isRefresh && data) note = t('net'); else { data = null; err = t('net'); }
      render();
    });
  }

  // ---- البدء: اللغة/المظهر المحفوظان، ثم ?c= أو الكود المحفوظ
  var q = {}; location.search.replace(/^\?/, '').split('&').forEach(function (p) { var kv = p.split('='); if (kv[0]) q[kv[0]] = decodeURIComponent(kv[1] || ''); });
  var sl = store('apo_adv_lang'); var nl = (navigator.language || 'ar').slice(0, 2);
  lang = T[q.l] ? q.l : (T[sl] ? sl : (T[nl] ? nl : 'ar'));
  var sth = store('apo_adv_theme'); theme = (sth === 'light' || sth === 'dark') ? sth : 'auto';
  applyTheme();
  code = q.c || store('apo_adv_code') || '';
  render();
  if (code) load(false);
  // تنظيف الكود من شريط العنوان بعد القراءة (لا يبقى في السجل)
  if (q.c && window.history && history.replaceState) { try { history.replaceState(null, '', location.pathname + (q.l ? '?l=' + encodeURIComponent(q.l) : '')); } catch (e) {} }
})();
</script>
