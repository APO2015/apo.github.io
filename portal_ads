      '<button class="btn block" type="button" id="scanbtn" style="margin-top:10px;background:transparent;color:var(--brand);border:1.5px solid var(--brand)">📷 ' + esc(SCANL[lang] || SCANL.ar) + '</button>' +
      (err ? '<div class="err">' + esc(err) + '</div>' : '') + '</div>';
  }

  function adState(a, now) {
    if (a.is_active !== true) return { k: 'off', c: '#94a3b8' };
    var w = winState(a.starts_at, a.ends_at, now);
    return w === 'live' ? { k: 'live', c: '#16a34a' } : (w === 'sched' ? { k: 'sched', c: '#0ea5e9' } : { k: 'exp', c: '#dc2626' });
  }
  function inTop(a, now) {
    return adState(a, now).k === 'live' && a.is_featured === true && (!a.featured_until || new Date(a.featured_until) > now);
  }
  function catLabel(c) { var k = 'cat_' + String(c || '').replace(/[^A-Za-z]+/g, '_'); return T[lang][k] || c || ''; }

  function linksOf(a) {
    var h = '';
