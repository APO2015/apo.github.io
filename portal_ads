  function adView(a, now) {
    var st = adState(a, now), top = inTop(a, now);
    var h = '<div class="card ad">' + imgOf(a) +
      '<div class="row"><span class="co">' + esc(a.company_name) + '</span>' + (a.category ? '<span class="cat">' + esc(catLabel(a.category)) + '</span>' : '') +
