    if (a.whatsapp) h += '<a href="https://wa.me/' + esc(digits(a.whatsapp).replace(/^\+/, '')) + '" target="_blank" rel="noopener">💬 ' + esc(t('wa')) + '</a>';
    [['map_url', '📍', 'map'], ['website_url', '🌐', 'web'], ['video_url', '🎬', 'video']].forEach(function (x) { var u = safeUrl(a[x[0]]); if (u) h += '<a href="' + esc(u) + '" target="_blank" rel="noopener">' + x[1] + ' ' + esc(t(x[2])) + '</a>'; });
    [['facebook_url', 'Facebook'], ['instagram_url', 'Instagram'], ['youtube_url', 'YouTube'], ['twitter_url', 'X']].forEach(function (x) { var u = safeUrl(a[x[0]]); if (u) h += '<a href="' + esc(u) + '" target="_blank" rel="noopener">🔗 ' + x[1] + '</a>'; });
    return h ? '<div class="links">' + h + '</div>' : '';
  }

  function imgOf(a) { var u = safeUrl(a.image_url); return u ? '<img src="' + esc(u) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'">' : ''; }

  function slideView(a) {
    var u = safeUrl(a.image_url);
    return '<div class="slide">' + (u ? '<img src="' + esc(u) + '" alt="" onerror="this.outerHTML=\'<div class=ph>📣</div>\'">' : '<div class="ph">📣</div>') +
      '<div class="tx"><div class="co">' + esc(a.company_name) + '</div><div class="ti">' + esc(a.title) + '</div></div></div>';
