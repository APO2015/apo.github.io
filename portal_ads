<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>APO Advertisers Portal</title>
<link rel="manifest" href="portal_ads.webmanifest">
<meta name="theme-color" content="#047857">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<style>
:root{--brand:#047857;--bg:#f6f7fb;--card:#fff;--ink:#0f172a;--mute:#64748b;--line:#e2e8f0;--pink:#16a34a;--cyan:#0ea5e9;--ok:#16a34a;--warn:#f59e0b;--bad:#dc2626;--shadow:0 6px 24px rgba(15,23,42,.08);--glow:rgba(22,163,74,.30)}
:root[data-theme="dark"]{--bg:#090d16;--card:#131b2e;--ink:#e8eef9;--mute:#94a3b8;--line:#243049;--shadow:0 6px 24px rgba(0,0,0,.45);--glow:rgba(34,197,94,.45);--cyan:#38bdf8;--pink:#22c55e}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#090d16;--card:#131b2e;--ink:#e8eef9;--mute:#94a3b8;--line:#243049;--shadow:0 6px 24px rgba(0,0,0,.45);--glow:rgba(34,197,94,.45);--cyan:#38bdf8;--pink:#22c55e}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans Arabic",Tahoma,sans-serif;line-height:1.55;padding:0 16px 48px}
.wrap{max-width:820px;margin:0 auto}
header{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:16px 0 6px}
header .brand{display:flex;align-items:center;gap:10px;min-width:0}
header .logo{width:46px;height:46px;object-fit:contain;flex:none;filter:drop-shadow(0 0 8px var(--glow))}
header .sub{font-size:12.5px;color:var(--mute);margin-top:2px}
header h1{font-size:19px;margin:0;color:var(--pink);text-shadow:0 0 14px var(--glow)}
.tools{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:5px 12px;font-size:13px;cursor:pointer;transition:box-shadow .2s,border-color .2s}
.chip:hover{border-color:var(--cyan);box-shadow:0 0 12px var(--glow)}
.chip.on{background:var(--pink);color:#fff;border-color:var(--pink)}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin:12px 0;box-shadow:var(--shadow);transition:box-shadow .25s,border-color .25s}
.card:hover{border-color:var(--pink);box-shadow:0 0 18px var(--glow)}
h2{font-size:15px;margin:22px 4px 6px;color:var(--mute);font-weight:700}
.hello{font-size:21px;font-weight:800;margin:2px 0}
.sub{color:var(--mute);font-size:13px}
input{width:100%;font-size:22px;letter-spacing:3px;text-align:center;padding:14px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);direction:ltr;text-transform:uppercase}
input:focus{outline:none;border-color:var(--pink);box-shadow:0 0 0 3px var(--glow)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:12px 18px;font-size:15px;font-weight:700;background:var(--pink);color:#fff;cursor:pointer;transition:box-shadow .2s,transform .1s}
.btn:hover{box-shadow:0 0 16px var(--glow)}
.btn:active{transform:scale(.98)}
.btn.block{width:100%;margin-top:12px}
.btn.alt{background:var(--card);color:var(--pink);border:1.5px solid var(--pink);width:100%;margin-top:12px;padding:13px;font-size:16px}
.btn[disabled]{opacity:.65;cursor:wait}
.ok{color:var(--ok);text-align:center;margin-top:8px;font-size:13.5px}
.btn.alt:hover{box-shadow:0 0 16px var(--glow)}
@keyframes spin{to{transform:rotate(360deg)}}
.spin{display:inline-block;animation:spin .8s linear infinite}
.err{color:var(--bad);text-align:center;margin-top:10px;font-size:14px}
.pill{display:inline-block;border-radius:999px;padding:3px 11px;font-size:12.5px;font-weight:700;color:#fff;white-space:nowrap}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;margin-top:10px}
.kv div{background:var(--bg);border-radius:10px;padding:8px 10px;font-size:13px;color:var(--mute)}
.kv b{display:block;color:var(--ink);font-size:14.5px;margin-top:2px}
.agree{white-space:pre-wrap;background:var(--bg);border-radius:10px;padding:10px 12px;margin-top:10px;font-size:14px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.note{background:rgba(14,165,233,.1);border:1px dashed var(--cyan);border-radius:12px;padding:10px 12px;font-size:13px;margin:10px 0}
/* الحقل العلوي المتنقل */
.slider{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:4px 2px 10px}
.slide{flex:0 0 86%;scroll-snap-align:center;border-radius:16px;overflow:hidden;border:1px solid var(--pink);box-shadow:0 0 20px var(--glow);background:var(--card)}
.slide .ph{height:170px;background:linear-gradient(135deg,var(--pink),var(--cyan));display:flex;align-items:center;justify-content:center;color:#fff;font-size:34px}
.slide img,.ad img{width:100%;height:170px;object-fit:cover;display:block}
.slide .tx{padding:10px 12px}
.ad img{height:auto;aspect-ratio:16/9;border-radius:12px;margin-bottom:10px}
.ad .co{font-weight:800;font-size:16px}
.ad .ti{font-weight:700;margin-top:6px}
.ad .ds{color:var(--mute);font-size:14px;margin-top:4px;white-space:pre-wrap}
.cat{display:inline-block;background:rgba(14,165,233,.14);color:var(--cyan);border-radius:999px;padding:2px 10px;font-size:12px;font-weight:700}
.links{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.links a{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-size:13px;color:var(--ink);text-decoration:none;transition:box-shadow .2s,border-color .2s}
.links a:hover{border-color:var(--pink);box-shadow:0 0 12px var(--glow)}
