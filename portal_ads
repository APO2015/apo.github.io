  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function safeUrl(u) { u = String(u || '').trim(); return /^https?:\/\//i.test(u) ? u : ''; }
  function digits(p) { return String(p || '').replace(/[^0-9+]/g, ''); }
  function two(n) { return (n < 10 ? '0' : '') + n; }
  function ymd(v) { if (!v) return ''; var d = new Date(v); if (isNaN(d)) return String(v).slice(0, 10); return d.getFullYear() + '-' + two(d.getMonth() + 1) + '-' + two(d.getDate()); }
  function hm(d) { return two(d.getHours()) + ':' + two(d.getMinutes()); }

  // ---- الكود: التطبيع وحرف التحقق (مطابق لـSQL 45 وللتطبيق)
  function norm(raw) {
    var s = String(raw || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
